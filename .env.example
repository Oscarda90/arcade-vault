# Copia este archivo a .env.local y rellena los valores.

# ── Resend (formulario de contacto) ─────────────────────────────
# Variables de servidor: NUNCA uses el prefijo NEXT_PUBLIC_.

# API key de Resend (https://resend.com/api-keys). Obligatoria.
RESEND_API_KEY=

# Destinatario de los mensajes del formulario de contacto. Obligatoria.
# Mientras se use el remitente onboarding@resend.dev, Resend solo entrega
# al correo dueño de la cuenta: usa ese correo hasta verificar un dominio.
CONTACT_TO_EMAIL=

# Remitente. Opcional. Default: Arcade Vault <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# ── Supabase (autenticación) ────────────────────────────────────
# Públicas (llegan al navegador). Dashboard → Project Settings → API Keys.

# URL del proyecto, p. ej. https://<project-ref>.supabase.co. Obligatoria.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key del dashboard → API Keys (sb_publishable_…). Obligatoria.
# NUNCA pongas aquí la secret / service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública del sitio, base del enlace de confirmación de correo.
# Variable de servidor. Opcional. Default: http://localhost:3000
SITE_URL=
